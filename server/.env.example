# Copy this file to .env and fill in your key.
# Used by /api/humanize to call the Groq API (free tier: https://console.groq.com/keys).
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
GROQ_MODEL=openai/gpt-oss-20b
PORT=8787

# Optional: enables a second, real ML-based AI-detection score in /api/detect
# (Sapling's trained classifier, not a heuristic). Free tier: 50k chars/day.
# Get a key at https://sapling.ai/ (API settings dashboard).
SAPLING_API_KEY=your_sapling_api_key_here
